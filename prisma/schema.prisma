generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Faculty {
  id         String   @id @default(uuid())
  name       String
  department String
  email      String   @unique
  password   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Student {
  rollNumber           String         @id
  name                 String
  department           String
  semester             Int
  attendance           Float
  internalMarks        Float
  semesterMarks        Float
  assignmentsSubmitted Int
  assignmentsTotal     Int
  backlogs             Int
  practicalMarks       Float
  password             String
  
  // Stored as JSON strings/objects in MySQL
  socioeconomic        Json
  behavioral           Json
  
  // Machine Learning Prediction State
  riskStatus           String         @default("Low")
  riskConfidence       Int            @default(0)
  riskReasons          Json
  recommendations      Json

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  interventions        Intervention[]
}

model Intervention {
  id                    String   @id @default(uuid())
  rollNumber            String
  studentName           String
  type                  String
  createdDate           DateTime @default(now())
  remarks               String   @db.Text
  status                String
  followUpDate          DateTime
  improvementPercentage Int      @default(0)
  facultyName           String
  
  student               Student  @relation(fields: [rollNumber], references: [rollNumber])

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
